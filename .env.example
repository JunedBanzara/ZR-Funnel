# ==============================================================================
# ZR INTERIOR DESIGN — ENVIRONMENT CONFIGURATION
# Copy this file to .env and supply your verified credentials.
# ==============================================================================

# Application Server
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. RAZORPAY PAYMENT GATEWAY (Fee: ₹199 INR)
# ------------------------------------------------------------------------------
# In Development/Testing: Use Razorpay Test Key (starts with rzp_test_)
# In Production: Replace with Live Key (starts with rzp_live_) after approval.
# Obtain keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE

# ------------------------------------------------------------------------------
# 2. CALENDLY SCHEDULING (45-Minute Consultation)
# ------------------------------------------------------------------------------
# Use the direct 45-minute consultation event type link.
CALENDLY_URL=https://calendly.com/zrinteriordesign/45min-consultation

# ------------------------------------------------------------------------------
# 3. WHATSAPP NOTIFICATIONS & AUTOMATION
# ------------------------------------------------------------------------------
# Official Meta WhatsApp Cloud API (Graph API v18.0+)
# Obtain credentials from: https://developers.facebook.com/apps/
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_PHONE=917878588859

# ------------------------------------------------------------------------------
# 4. META ADS TRACKING (PIXEL & CONVERSIONS API)
# ------------------------------------------------------------------------------
# Set your Meta Pixel ID (numeric string)
META_PIXEL_ID=
META_CONVERSIONS_API_TOKEN=
